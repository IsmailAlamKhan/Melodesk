{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Our own UI window: core window/event APIs, the player commands, and local SQLite.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:app:allow-version",
    "allow-player-command",
    "allow-player-set-visible",
    "allow-get-settings",
    "allow-set-settings",
    "sql:default",
    "sql:allow-execute",
    "store:default",
    "notification:default",
    "opener:default",
    "os:default",
    "process:default",
    "autostart:default",
    "global-shortcut:default",
    "deep-link:default",
    "updater:default"
  ]
}
