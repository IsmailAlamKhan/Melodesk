{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Our own UI window: core window/event APIs, the player commands, and local SQLite.",
  "windows": ["main", "mini"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:app:allow-version",
    "allow-player-command",
    "allow-player-set-visible",
    "allow-player-reload",
    "allow-get-settings",
    "allow-set-settings",
    "allow-discord-set-activity",
    "allow-discord-clear",
    "allow-open-mini-player",
    "allow-set-native-labels",
    "allow-native-modules",
    "allow-local-scan",
    "allow-local-read-file",
    "allow-local-artwork",
    "allow-local-lyrics-sidecar",
    "allow-local-set-active",
    "allow-local-report",
    "allow-local-write-tags",
    "allow-control-start",
    "allow-control-stop",
    "allow-net-allow",
    "allow-net-text",
    "allow-net-bytes",
    "allow-radio-open",
    "dialog:allow-open",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-size",
    "core:window:allow-start-resize-dragging",
    "sql:default",
    "sql:allow-execute",
    "store:default",
    "notification:default",
    "opener:default",
    "os:default",
    "process:default",
    "autostart:default",
    "deep-link:default",
    "updater:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://lrclib.net/*" },
        { "url": "https://music.163.com/*" },
        { "url": "https://api.lyrics.ovh/*" },
        { "url": "https://musicbrainz.org/*" },
        { "url": "https://ws.audioscrobbler.com/*" },
        { "url": "https://api.listenbrainz.org/*" },
        { "url": "https://api.mymemory.translated.net/*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}
