{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Our own UI window: core window/event APIs, the player commands, and local SQLite.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "allow-player-command",
    "allow-player-set-visible",
    "sql:default",
    "sql:allow-execute"
  ]
}
