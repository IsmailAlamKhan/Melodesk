{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melodesk",
  "version": "0.1.0",
  "identifier": "app.melodesk.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @melodesk/bridge build && pnpm --filter @melodesk/desktop dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @melodesk/bridge build && pnpm --filter @melodesk/desktop build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Melodesk",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https://*.googleusercontent.com https://*.ggpht.com https://i.ytimg.com https://www.gstatic.com",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "freezePrototype": false
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["melodesk"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2REM1RDlBRDlFMTUwNkEKUldScVVPSFptbDNjZGhxN2swOVh5aHhDZkFRQkxON3JRUVhqenZOVW9QYkxxVmZEOUtUREJmeWoK",
      "endpoints": ["https://github.com/melodesk/melodesk/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
