{
  "name": "melodesk-monorepo",
  "private": true,
  "type": "module",
  "version": "0.7.0",
  "description": "Melodesk — an open-source native desktop client for YouTube Music (not affiliated with Google or YouTube)",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @melodesk/desktop tauri dev",
    "build": "pnpm --filter @melodesk/desktop tauri build",
    "build:bridge": "pnpm --filter @melodesk/bridge build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "clippy": "pnpm clippy:bare && pnpm clippy:modules",
    "clippy:bare": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --no-default-features --all-targets -- -D warnings",
    "clippy:modules": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --no-default-features --features discord,shortcuts --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --no-default-features --features discord,shortcuts",
    "features:removable": "node scripts/check-features-removable.mjs",
    "fmt:rust": "node scripts/fmt-rust.mjs",
    "test:e2e": "pnpm --filter @melodesk/desktop test:e2e",
    "screenshots": "pnpm --filter @melodesk/desktop screenshots",
    "check": "pnpm typecheck && pnpm lint && pnpm i18n:check && pnpm test && pnpm features:removable && pnpm test:e2e && pnpm fmt:rust && pnpm clippy && pnpm test:rust",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:new": "node scripts/i18n-check.mjs --new"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
